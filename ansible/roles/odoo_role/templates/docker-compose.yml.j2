services:
  {{ odoo_db_service_name }}:
    image: {{ odoo_db_image }}
    container_name: {{ odoo_db_container_name }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: "{{ odoo_db_name }}"
      POSTGRES_USER: "{{ odoo_db_user }}"
      POSTGRES_PASSWORD: "${ODOO_DB_PASSWORD:?ODOO_DB_PASSWORD doit être fourni}"
    volumes:
      - {{ odoo_db_volume_name }}:{{ odoo_db_mount_path }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ odoo_db_user }} -d {{ odoo_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - app-network

  {{ odoo_app_service_name }}:
    image: {{ odoo_app_image }}
    container_name: {{ odoo_app_container_name }}
    restart: unless-stopped
    depends_on:
      {{ odoo_db_service_name }}:
        condition: service_healthy
    ports:
      - "{{ odoo_host_port }}:8069"
    environment:
      HOST: "{{ odoo_db_service_name }}"
      USER: "{{ odoo_db_user }}"
      PASSWORD: "${ODOO_DB_PASSWORD:?ODOO_DB_PASSWORD doit être fourni}"
    volumes:
      - {{ odoo_data_volume_name }}:{{ odoo_data_mount_path }}
    networks:
      - app-network

volumes:
  {{ odoo_db_volume_name }}:
    name: {{ odoo_db_volume_name }}
{% if odoo_bind_mounts_enabled | bool %}
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ odoo_db_host_path }}"
{% endif %}
  {{ odoo_data_volume_name }}:
    name: {{ odoo_data_volume_name }}
{% if odoo_bind_mounts_enabled | bool %}
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ odoo_data_host_path }}"
{% endif %}

networks:
  app-network:
    name: {{ odoo_network_name }}
    driver: bridge