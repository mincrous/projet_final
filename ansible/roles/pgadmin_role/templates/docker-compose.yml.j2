services:
  {{ pgadmin_service_name }}:
    image: {{ pgadmin_image }}
    container_name: {{ pgadmin_container_name }}
    restart: unless-stopped
    ports:
      - "{{ pgadmin_host_port }}:80"
    environment:
      PGADMIN_DEFAULT_EMAIL: "{{ pgadmin_default_email }}"
      PGADMIN_DEFAULT_PASSWORD: "${PGADMIN_DEFAULT_PASSWORD:?PGADMIN_DEFAULT_PASSWORD doit être fourni}"
    volumes:
      - {{ pgadmin_data_volume_name }}:{{ pgadmin_data_mount_path }}
    networks:
      - app-network

volumes:
  {{ pgadmin_data_volume_name }}:
    name: {{ pgadmin_data_volume_name }}
{% if pgadmin_bind_mounts_enabled | bool %}
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ pgadmin_data_host_path }}"
{% endif %}

networks:
  app-network:
    name: {{ pgadmin_network_name }}
    external: {{ pgadmin_network_external | bool | lower }}